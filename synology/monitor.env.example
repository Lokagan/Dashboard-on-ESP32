# MODÈLE — copier vers `monitor.env` puis renseigner les valeurs.
# `monitor.env` est ignoré par git (secrets), ce template ne l'est pas.
#
#   cp synology/monitor.env.example synology/monitor.env

# Intervalles
REFRESH_INTERVAL=5

# NAS Synology
NAS_HOST=192.168.1.1
NAS_PORT=5000
NAS_USER=votre_user_dsm
NAS_PASSWORD=votre_mdp_dsm

# MQTT
MQTT_BROKER=192.168.1.1
MQTT_PORT=1883

# Freebox
FREEBOX_HOST=192.168.1.254
FREEBOX_API=v6
APP_ID=dashboard.esp32
# Token à générer une seule fois via : python3 scripts/freebox_get_token.py
APP_TOKEN=votre_app_token_freebox

# LLM (endpoint + secrets seulement — modèle, voix, prompt, météo et actus
# sont dans scripts/bridge_defaults.json, modifiables depuis la page config)
# Clé API : https://console.groq.com/keys
GROQ_API_KEY=gsk_votre_cle_groq
LLM_BASE_URL=https://api.groq.com/openai/v1
TIMEZONE=Europe/Paris

# Mémoire de conversation (optionnel — décommenter pour ajuster, sinon défauts)
#   MAX_EXCHANGES : nb d'échanges Q-R gardés en contexte (défaut 10).
#     ⚠️ renvoyé au LLM à CHAQUE requête → plus de tokens/latence si tu montes.
#   TTL_S : purge après N secondes d'inactivité (défaut 600 = 10 min ; gratuit).
#AI_CONVERSATION_MAX_EXCHANGES=10
#AI_CONVERSATION_TTL_S=600

# Activité réseau — AdGuard Home (journal DNS par appareil, écran « Activité réseau »)
# Identifiants de l'assistant d'installation AGH. Page servie sur le port 8091.
AGH_URL=http://192.168.1.1:3000
AGH_USER=admin
AGH_PASS=votre_mdp_adguard
